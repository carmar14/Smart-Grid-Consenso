clc
clear
close all

%----parametros del sistema---
Lf = 1e-3;
Lc = .5e-3;
Cf = 5e-6;

R = 1;
L = 5e-3;

%-----MPC-----
%xp=Ax+Bu+Ed
%y =Cx+Du
%-----|iLf|
%---x=|Vcf|
%-----|ILc|

%---u= Vinv

%--d=vout----perturbacion


A = [0 -1/Lf 0;
     1/Cf 0 -1/Cf;
     0 1/Lc 0];

B = [1/Lf 0 0]';
%---y --_regular corriente hacia la carga y voltaje del capacitor
C = [0 1 0;
     0 0 1];

D = 0;

%% Sampling Time

Ts = 50e-6;

%% Continuous system

plant_c = ss(A,B,C,D);

%% Discrete model

plant = c2d(plant_c,Ts);
%% ============================================================
% MPC OBJECT
% ============================================================

PredictionHorizon = 20;

ControlHorizon = 5;

mpcobj = mpc(plant,Ts,...
             PredictionHorizon,...
             ControlHorizon);

%% ============================================================
% WEIGHTS
% ============================================================

mpcobj.Weights.OutputVariables = 10;

mpcobj.Weights.ManipulatedVariables = 0;

mpcobj.Weights.ManipulatedVariablesRate = 0.1;

%% ============================================================
% INPUT CONSTRAINTS
% ============================================================

mpcobj.MV.Min = -400;

mpcobj.MV.Max = 400;

mpcobj.MV.RateMin = -100;

mpcobj.MV.RateMax = 100;

%% ============================================================
% OUTPUT CONSTRAINTS (optional)
% ============================================================

% mpcobj.OV.Min = -311;
% mpcobj.OV.Max = 311;

%% ============================================================
% NOMINAL CONDITIONS
% ============================================================

mpcobj.Model.Nominal.U = 0;

mpcobj.Model.Nominal.Y = 0;

mpcobj.Model.Nominal.X = zeros(size(plant.A,1),1);

%% ============================================================
% ESTIMATOR
% ============================================================

setEstimator(mpcobj,'default');

%% ============================================================
% SAVE OBJECT
% ============================================================

save MPC_Local_Controller mpcobj

disp('MPC created successfully')